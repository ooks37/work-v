#!/usr/bin/env bash
# ==============================================================================
# Work-V 分布式网络与订阅中枢 · 全功能终端运维管理面板 (类似宝塔 bt 运维指令)
# ==============================================================================
set -e

COLOR_GREEN="\033[32m"
COLOR_RED="\033[31m"
COLOR_YELLOW="\033[33m"
COLOR_BLUE="\033[34m"
COLOR_CYAN="\033[36m"
COLOR_BOLD="\033[1m"
COLOR_RESET="\033[0m"

APP_DIR="/opt/work-v-master"
BIN_FILE="$APP_DIR/work-v-master"
DB_FILE="$APP_DIR/data/work-v.db"
SERVICE_MASTER="work-v-master"
SERVICE_AGENT="work-v-agent"

read_input() {
    local prompt="$1"
    local var_name="$2"
    local default_val="$3"
    local val=""

    if [ -t 0 ]; then
        read -r -p "$prompt" val
    elif (exec 3< /dev/tty) 2>/dev/null; then
        read -r -p "$prompt" val < /dev/tty
    else
        read -r -p "$prompt" val 2>/dev/null || val=""
    fi

    if [ -z "$val" ] && [ -n "$default_val" ]; then
        val="$default_val"
    fi
    # 用 printf -v 赋值: eval 会把用户输入里的引号/$(...) 当代码执行
    printf -v "$var_name" '%s' "$val"
}

check_master_active() {
    if systemctl is-active "$SERVICE_MASTER" &>/dev/null; then
        echo -e "${COLOR_GREEN}🟢 运行中${COLOR_RESET}"
    elif [ -f "$BIN_FILE" ]; then
        echo -e "${COLOR_RED}🔴 已停止${COLOR_RESET}"
    else
        echo -e "${COLOR_YELLOW}⚪ 未安装${COLOR_RESET}"
    fi
}

check_agent_active() {
    if systemctl is-active "$SERVICE_AGENT" &>/dev/null; then
        echo -e "${COLOR_GREEN}🟢 运行中${COLOR_RESET}"
    elif [ -f "/opt/work-v-agent/work-v-agent" ]; then
        echo -e "${COLOR_RED}🔴 已停止${COLOR_RESET}"
    else
        echo -e "${COLOR_YELLOW}⚪ 未安装${COLOR_RESET}"
    fi
}

show_info() {
    if [ -f "$BIN_FILE" ]; then
        $BIN_FILE -entry -db "$DB_FILE"
    else
        echo -e "${COLOR_RED}❌ 本机未安装 Work-V Master 主控端${COLOR_RESET}"
    fi
}

restart_service() {
    echo -e "${COLOR_YELLOW}正在重启 Work-V 服务...${COLOR_RESET}"
    if [ -f "/etc/systemd/system/${SERVICE_MASTER}.service" ]; then
        systemctl restart "$SERVICE_MASTER"
        echo -e "Master: $(check_master_active)"
    fi
    if [ -f "/etc/systemd/system/${SERVICE_AGENT}.service" ]; then
        systemctl restart "$SERVICE_AGENT"
        echo -e "Agent:  $(check_agent_active)"
    fi
    echo -e "${COLOR_GREEN}✅ 服务重启完成！${COLOR_RESET}"
}

stop_service() {
    echo -e "${COLOR_YELLOW}正在停止 Work-V 服务...${COLOR_RESET}"
    systemctl stop "$SERVICE_MASTER" 2>/dev/null || true
    systemctl stop "$SERVICE_AGENT" 2>/dev/null || true
    echo -e "${COLOR_GREEN}✅ 服务已停止！${COLOR_RESET}"
}

start_service() {
    echo -e "${COLOR_YELLOW}正在启动 Work-V 服务...${COLOR_RESET}"
    systemctl start "$SERVICE_MASTER" 2>/dev/null || true
    systemctl start "$SERVICE_AGENT" 2>/dev/null || true
    echo -e "${COLOR_GREEN}✅ 服务已启动！${COLOR_RESET}"
}

show_status() {
    echo -e "${COLOR_CYAN}==================================================================${COLOR_RESET}"
    echo -e "                 Work-V 运行状态与资源统计                        "
    echo -e "${COLOR_CYAN}==================================================================${COLOR_RESET}"
    if [ -f "/etc/systemd/system/${SERVICE_MASTER}.service" ]; then
        echo -e "【Master 主控端】"
        systemctl status "$SERVICE_MASTER" --no-pager -l || true
        echo ""
    fi
    if [ -f "/etc/systemd/system/${SERVICE_AGENT}.service" ]; then
        echo -e "【Agent 从节点】"
        systemctl status "$SERVICE_AGENT" --no-pager -l || true
        echo ""
    fi
    echo -e "【系统内存与进程负载】"
    free -h
    echo -e "${COLOR_CYAN}==================================================================${COLOR_RESET}"
}

show_log() {
    echo -e "${COLOR_YELLOW}请选择需要查看的日志：${COLOR_RESET}"
    echo "  [1] Master 主控端日志"
    echo "  [2] Agent 从节点日志"
    read_input "请选择 [默认 1]: " log_choice "1"
    if [ "$log_choice" = "2" ]; then
        journalctl -u "$SERVICE_AGENT" -f -n 40
    else
        journalctl -u "$SERVICE_MASTER" -f -n 40
    fi
}

set_safe_entry() {
    local new_path="$1"
    if [ -z "$new_path" ]; then
        read_input "请输入新的安全入口路径 (例如 /safe_entry 或 /my_console): " new_path ""
    fi
    if [ -n "$new_path" ]; then
        $BIN_FILE -set-entry "$new_path" -db "$DB_FILE"
        systemctl restart "$SERVICE_MASTER"
        echo -e "${COLOR_GREEN}✅ 安全入口已更新并自动重启生效！${COLOR_RESET}"
    fi
}

disable_safe_entry() {
    $BIN_FILE -disable-entry -db "$DB_FILE"
    systemctl restart "$SERVICE_MASTER"
    echo -e "${COLOR_GREEN}✅ 安全入口保护已关闭！可直接访问域名登录。${COLOR_RESET}"
}

set_password() {
    local pwd="$1"
    if [ -z "$pwd" ]; then
        read_input "请输入管理员 admin 的新密码: " pwd ""
    fi
    if [ -n "$pwd" ]; then
        $BIN_FILE -set-password "$pwd" -db "$DB_FILE"
    fi
}

reset_password_default() {
    $BIN_FILE -reset-admin -db "$DB_FILE"
}

list_all_nodes() {
    if [ -f "$BIN_FILE" ]; then
        $BIN_FILE -nodes -db "$DB_FILE"
    fi
}

add_new_node() {
    local node_name="$1"
    if [ -z "$node_name" ]; then
        read_input "请输入新节点标识名称 (如 香港BGP-01 / 美西CN2): " node_name "新建节点"
    fi
    if [ -f "$BIN_FILE" ]; then
        $BIN_FILE -add-node "$node_name" -db "$DB_FILE"
    fi
}

test_nginx() {
    echo -e "${COLOR_YELLOW}检查 Nginx 配置与反代连通性...${COLOR_RESET}"
    if command -v nginx &>/dev/null; then
        nginx -t || true
    fi
    echo -e "${COLOR_YELLOW}测试本地响应状态码...${COLOR_RESET}"
    curl -s -o /dev/null -w "• 本地 127.0.0.1:8080: %{http_code}\n" http://127.0.0.1:8080/ || true
    if [ -f "$BIN_FILE" ]; then
        local cur_info
        cur_info=$($BIN_FILE -entry -db "$DB_FILE" 2>/dev/null | grep -i "访问入口" | awk '{print $NF}' | head -n 1 || true)
        if [ -n "$cur_info" ]; then
            curl -s -o /dev/null -w "• 当前配置入口 $cur_info: %{http_code}\n" "$cur_info" || true
        fi
    fi
    echo -e "${COLOR_GREEN}✅ 测试完成！${COLOR_RESET}"
}

set_domain() {
    local new_dom="$1"
    if [ -z "$new_dom" ]; then
        echo -e "${COLOR_CYAN}===== 配置/修改 Work-V 主控外网访问域名 =====${COLOR_RESET}"
        read_input "请输入您的域名 (例如 vpn.example.com，输入 none 或留空则恢复纯 IP 访问): " new_dom ""
    fi
    if [ -f "$BIN_FILE" ]; then
        if [ "$new_dom" = "none" ] || [ "$new_dom" = "clear" ] || [ -z "$new_dom" ]; then
            $BIN_FILE -domain "none" -db "$DB_FILE"
            if [ -f "/etc/systemd/system/${SERVICE_MASTER}.service" ]; then
                sed -i "s| -domain [^ ]*||g" "/etc/systemd/system/${SERVICE_MASTER}.service" 2>/dev/null || true
                systemctl daemon-reload 2>/dev/null || true
            fi
            systemctl restart "$SERVICE_MASTER" 2>/dev/null || true
            echo -e "${COLOR_GREEN}✅ 已清除域名绑定，恢复为纯 IP 直连访问模式！${COLOR_RESET}"
        else
            new_dom=$(echo "$new_dom" | tr -d ' ' | sed -E 's|^https?://||; s|/$||')
            $BIN_FILE -domain "$new_dom" -db "$DB_FILE"
            if [ -f "/etc/systemd/system/${SERVICE_MASTER}.service" ]; then
                sed -i "s| -domain [^ ]*||g" "/etc/systemd/system/${SERVICE_MASTER}.service" 2>/dev/null || true
                sed -i "s|work-v.db|work-v.db -domain $new_dom|g" "/etc/systemd/system/${SERVICE_MASTER}.service" 2>/dev/null || true
                systemctl daemon-reload 2>/dev/null || true
            fi
            systemctl restart "$SERVICE_MASTER" 2>/dev/null || true
            echo -e "${COLOR_GREEN}✅ 域名配置已保存并已重启主控服务！${COLOR_RESET}"
        fi
        $BIN_FILE -entry -db "$DB_FILE"
    else
        echo -e "${COLOR_RED}❌ 主控端二进制不存在${COLOR_RESET}"
    fi
}

drop_caches() {
    echo -e "${COLOR_YELLOW}正在释放系统缓存并整理内存...${COLOR_RESET}"
    sync
    echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true
    free -h
    echo -e "${COLOR_GREEN}✅ 内存缓存已深度清理！${COLOR_RESET}"
}

uninstall_confirm() {
    read_input "确定要卸载 Work-V 服务吗？[y/N]: " confirm "N"
    if [[ "$confirm" =~ ^[yY]$ ]]; then
        systemctl stop "$SERVICE_MASTER" "$SERVICE_AGENT" 2>/dev/null || true
        systemctl disable "$SERVICE_MASTER" "$SERVICE_AGENT" 2>/dev/null || true
        rm -f "/etc/systemd/system/${SERVICE_MASTER}.service" "/etc/systemd/system/${SERVICE_AGENT}.service"
        systemctl daemon-reload
        echo -e "${COLOR_GREEN}✅ Work-V 服务与守护已被安全移除。${COLOR_RESET}"
    fi
}

check_ports() {
    echo -e "${COLOR_CYAN}===== 正在扫描系统当前开放端口与网络监听 =====${COLOR_RESET}"
    ss -lntup 2>/dev/null || netstat -lntup 2>/dev/null || echo "无法获取端口状态"
    echo -e "${COLOR_YELLOW}💡 提示: TCP 协议请确认放行 TCP，UDP 协议 (Hysteria2/TUIC) 请放行 UDP。${COLOR_RESET}"
}

update_singbox_core() {
    echo -e "${COLOR_YELLOW}正在检测 sing-box 官方最新版本...${COLOR_RESET}"
    local current_ver
    current_ver=$(/usr/local/bin/sing-box version 2>/dev/null | head -n 1 || echo "未安装")
    echo -e "当前内核: ${COLOR_GREEN}${current_ver}${COLOR_RESET}"

    local latest_tag
    latest_tag=$(curl -s "https://api.github.com/repos/SagerNet/sing-box/releases/latest" 2>/dev/null | grep '"tag_name":' | head -n 1 | sed -E 's/.*"([^"]+)".*/\1/' || true)
    if [ -z "$latest_tag" ]; then
        latest_tag="v1.13.12"
    fi
    local ver="${latest_tag#v}"
    echo -e "官方最新: ${COLOR_GREEN}v${ver}${COLOR_RESET}"

    local arch
    arch=$(uname -m)
    case "$arch" in
        x86_64) go_arch="amd64" ;;
        aarch64|arm64) go_arch="arm64" ;;
        *) go_arch="amd64" ;;
    esac

    local url="https://github.com/SagerNet/sing-box/releases/download/v${ver}/sing-box-${ver}-linux-${go_arch}.tar.gz"
    local mirror_url="https://ghfast.top/${url}"
    local tmp_dir="/tmp/sb-update-$ver"
    mkdir -p "$tmp_dir"

    echo -e "正在拉取官方预编译二进制包..."
    if ! curl -fsSL --connect-timeout 10 --retry 2 "$url" -o "$tmp_dir/sb.tar.gz" 2>/dev/null; then
        echo -e "${COLOR_YELLOW}主源连接超时，切换加速镜像拉取...${COLOR_RESET}"
        curl -fsSL --connect-timeout 15 --retry 3 "$mirror_url" -o "$tmp_dir/sb.tar.gz" 2>/dev/null || true
    fi

    if [ -f "$tmp_dir/sb.tar.gz" ]; then
        tar -xzf "$tmp_dir/sb.tar.gz" -C "$tmp_dir" 2>/dev/null || true
        local new_bin
        new_bin=$(find "$tmp_dir" -type f -name sing-box 2>/dev/null | head -n 1)
        if [ -n "$new_bin" ] && "$new_bin" version &>/dev/null; then
            if [ -f "/usr/local/bin/sing-box" ]; then
                cp -f /usr/local/bin/sing-box "/usr/local/bin/sing-box.bak.$(date +%s)" 2>/dev/null || true
            fi
            cp -f "$new_bin" /usr/local/bin/sing-box
            chmod 755 /usr/local/bin/sing-box
            rm -rf "$tmp_dir"
            echo -e "${COLOR_GREEN}✅ sing-box 内核升级成功！新版本：$(/usr/local/bin/sing-box version | head -n 1)${COLOR_RESET}"
            systemctl restart "$SERVICE_MASTER" "$SERVICE_AGENT" 2>/dev/null || true
            return 0
        fi
    fi
    rm -rf "$tmp_dir"
    echo -e "${COLOR_RED}❌ 内核更新失败，请检查网络连接${COLOR_RESET}"
}

run_diagnostics() {
    echo -e "${COLOR_CYAN}================================================================================${COLOR_RESET}"
    echo -e "       ${COLOR_GREEN}${COLOR_BOLD}Work-V 分布式网络与订阅中枢 · 系统综合诊断报告${COLOR_RESET}        "
    echo -e "${COLOR_CYAN}================================================================================${COLOR_RESET}"
    echo -e "操作系统: ${COLOR_GREEN}$(grep PRETTY_NAME /etc/os-release 2>/dev/null | cut -d= -f2 | tr -d '\"' || uname -s)${COLOR_RESET}"
    echo -e "系统内核: $(uname -r) ($(uname -m))"
    echo -e "TCP BBR:  ${COLOR_GREEN}$(sysctl net.ipv4.tcp_congestion_control 2>/dev/null | awk '{print $3}')${COLOR_RESET}"
    echo -e "Sing-box: $(/usr/local/bin/sing-box version 2>/dev/null | head -n 1 || echo '未安装')"
    echo -e "系统负载: $(uptime | awk -F'load average:' '{print $2}')"
    echo -e "${COLOR_CYAN}--------------------------------------------------------------------------------${COLOR_RESET}"
    echo "内存与Swap使用状态:"
    free -h
    echo -e "${COLOR_CYAN}--------------------------------------------------------------------------------${COLOR_RESET}"
    echo "服务运行状态:"
    echo "• Master 主控服务: $(systemctl is-active "$SERVICE_MASTER" 2>/dev/null || echo '未运行')"
    echo "• Agent  从节点:   $(systemctl is-active "$SERVICE_AGENT" 2>/dev/null || echo '未运行')"
    echo "• Nginx  反代:     $(systemctl is-active nginx 2>/dev/null || echo '未运行')"
    echo -e "${COLOR_CYAN}--------------------------------------------------------------------------------${COLOR_RESET}"
    echo "当前活跃网络监听端口:"
    ss -lntup 2>/dev/null | head -n 15
    echo -e "${COLOR_CYAN}================================================================================${COLOR_RESET}"
}

show_menu() {
    echo -e "${COLOR_CYAN}================================================================================${COLOR_RESET}"
    echo -e "       ${COLOR_GREEN}${COLOR_BOLD}Work-V 分布式网络与订阅中枢 · 终端运维管理平台 (v2.0.0)${COLOR_RESET}        "
    echo -e "${COLOR_CYAN}================================================================================${COLOR_RESET}"
    echo -e " 主控端 (Master): $(check_master_active)    从节点 (Agent): $(check_agent_active)"
    echo -e "${COLOR_CYAN}--------------------------------------------------------------------------------${COLOR_RESET}"
    echo -e " 【核心服务运维】                          【账号与安全管理】"
    echo -e "  (1)  重启 Work-V 服务                    (5)  查看面板访问地址与安全入口"
    echo -e "  (2)  停止 Work-V 服务                    (6)  修改安全入口路径"
    echo -e "  (3)  启动 Work-V 服务                    (7)  一键关闭安全入口限制 (免密入口)"
    echo -e "  (4)  查看服务运行状态 & 内存占用          (8)  修改管理员密码"
    echo -e "${COLOR_CYAN}--------------------------------------------------------------------------------${COLOR_RESET}"
    echo -e " 【分布式从属节点管理】                    【系统与环境维护】"
    echo -e "  (9)  查看所有受控节点列表与在线状态       (12) 检查 Nginx 反代与 SSL 连通性"
    echo -e "  (10) 快速添加新副节点 (生成纳管命令)     (13) 释放系统内存与缓存清理"
    echo -e "  (11) 查看服务实时运行日志                (14) 查看系统开放端口与协议监听"
    echo -e "                                           (15) 检查并在线升级 sing-box 内核"
    echo -e "                                           (16) 一键生成系统综合诊断报告"
    echo -e "                                           (17) 卸载清理 Work-V 服务"
    echo -e "                                           (18) 配置/绑定主控外网访问域名"
    echo -e "${COLOR_CYAN}================================================================================${COLOR_RESET}"
    echo -e "  (0)  退出管理"
    echo -e "${COLOR_CYAN}================================================================================${COLOR_RESET}"

    read_input "请输入操作编号 [0-18]: " choice ""
    case "$choice" in
        1) restart_service ;;
        2) stop_service ;;
        3) start_service ;;
        4) show_status ;;
        5) show_info ;;
        6) set_safe_entry ;;
        7) disable_safe_entry ;;
        8) set_password ;;
        9) list_all_nodes ;;
        10) add_new_node ;;
        11) show_log ;;
        12) test_nginx ;;
        13) drop_caches ;;
        14) check_ports ;;
        15) update_singbox_core ;;
        16) run_diagnostics ;;
        17) uninstall_confirm ;;
        18) set_domain ;;
        0) exit 0 ;;
        *) echo -e "${COLOR_RED}无效选项，请输入 0-18${COLOR_RESET}" ;;
    esac
}

# 命令行非交互快捷参数支持
case "$1" in
    default|entry|info) show_info ;;
    restart) restart_service ;;
    stop) stop_service ;;
    start) start_service ;;
    status) show_status ;;
    log|logs) show_log ;;
    passwd|password) set_password "$2" ;;
    reset-admin) reset_password_default ;;
    set-entry) set_safe_entry "$2" ;;
    disable-entry) disable_safe_entry ;;
    domain|set-domain) set_domain "$2" ;;
    nodes) list_all_nodes ;;
    add-node) add_new_node "$2" ;;
    test|nginx) test_nginx ;;
    clean|drop) drop_caches ;;
    ports) check_ports ;;
    update-core|update-singbox) update_singbox_core ;;
    diag|diagnostic) run_diagnostics ;;
    uninstall) uninstall_confirm ;;
    *) show_menu ;;
esac
